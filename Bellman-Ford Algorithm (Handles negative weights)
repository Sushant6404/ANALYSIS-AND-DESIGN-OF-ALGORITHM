#include <iostream>
#include <vector>
#include <climits>
using namespace std;

struct Edge
{
  int src, dest, weight;
};

void bellmanFord(vector<Edge> &edges, int V, int src)
{
  vector<int> dist(V, INT_MAX);
  dist[src] = 0;

  // Relax all edges V-1 times
  for (int i = 1; i <= V - 1; i++)
  {
    for (auto &edge : edges)
    {
      int u = edge.src;
      int v = edge.dest;
      int w = edge.weight;
      if (dist[u] != INT_MAX && dist[v] > dist[u] + w)
        dist[v] = dist[u] + w;
    }
  }

  // Check for negative cycles
  for (auto &edge : edges)
  {
    int u = edge.src;
    int v = edge.dest;
    int w = edge.weight;
    if (dist[u] != INT_MAX && dist[v] > dist[u] + w)
    {
      cout << "Graph contains negative weight cycle\n";
      return;
    }
  }

  cout << "Vertex\tDistance from Source\n";
  for (int i = 0; i < V; i++)
    cout << i << "\t" << dist[i] << endl;
}

int main()
{
  int V = 5;
  vector<Edge> edges = {
      {0, 1, 4}, {0, 2, 1}, {1, 3, 1}, {2, 1, 2}, {2, 3, 5}, {3, 4, 3}};

  bellmanFord(edges, V, 0);
  return 0;
}
