#include <iostream>
#include <vector>
#include <algorithm>
#include <stack>
using namespace std;

struct Point
{
  int x, y;
  bool operator<(const Point &p) const
  {
    return x < p.x || (x == p.x && y < p.y);
  }
};
int cross(const Point &O, const Point &A, const Point &B)
{
  return (A.x - O.x) * (B.y - O.y) - (A.y - O.y) * (B.x - O.x);
}

vector<Point> bruteForceHull(vector<Point> &points)
{
  vector<Point> hull;
  int n = points.size();

  for (int i = 0; i < n; i++)
  {
    for (int j = 0; j < n; j++)
    {
      if (i == j)
        continue;
      bool valid = true;

      for (int k = 0; k < n; k++)
      {
        if (k == i || k == j)
          continue;
        if (cross(points[i], points[j], points[k]) < 0)
        {
          valid = false;
          break;
        }
      }

      if (valid)
      {
        hull.push_back(points[i]);
        break;
      }
    }
  }
  return hull;
}

pair<int, int> findUpperTangent(const vector<Point> &leftHull, const vector<Point> &rightHull)
{
  int left = 0, right = 0;
  int n1 = leftHull.size(), n2 = rightHull.size();

  for (int i = 1; i < n1; i++)
  {
    if (leftHull[i].x > leftHull[left].x)
      left = i;
  }

  for (int i = 1; i < n2; i++)
  {
    if (rightHull[i].x < rightHull[right].x)
      right = i;
  }

  bool done = false;
  while (!done)
  {
    done = true;
    while (cross(rightHull[right], leftHull[left], leftHull[(left + 1) % n1]) <= 0)
    {
      left = (left + 1) % n1;
    }
    while (cross(leftHull[left], rightHull[right], rightHull[(right - 1 + n2) % n2]) >= 0)
    {
      right = (right - 1 + n2) % n2;
      done = false;
    }
  }

  return {left, right};
}

pair<int, int> findLowerTangent(const vector<Point> &leftHull, const vector<Point> &rightHull)
{
  int left = 0, right = 0;
  int n1 = leftHull.size(), n2 = rightHull.size();

  for (int i = 1; i < n1; i++)
  {
    if (leftHull[i].x > leftHull[left].x)
      left = i;
  }

  for (int i = 1; i < n2; i++)
  {
    if (rightHull[i].x < rightHull[right].x)
      right = i;
  }
  bool done = false;
  while (!done)
  {
    done = true;
    while (cross(rightHull[right], leftHull[left], leftHull[(left - 1 + n1) % n1]) >= 0)
    {
      left = (left - 1 + n1) % n1;
    }
    while (cross(leftHull[left], rightHull[right], rightHull[(right + 1) % n2]) <= 0)
    {
      right = (right + 1) % n2;
      done = false;
    }
  }

  return {left, right};
}

vector<Point> mergeHulls(vector<Point> &leftHull, vector<Point> &rightHull)
{
  auto upper = findUpperTangent(leftHull, rightHull);
  auto lower = findLowerTangent(leftHull, rightHull);

  vector<Point> mergedHull;
  int i = upper.first;
  mergedHull.push_back(leftHull[i]);
  while (i != lower.first)
  {
    i = (i + 1) % leftHull.size();
    mergedHull.push_back(leftHull[i]);
  }
  i = lower.second;
  mergedHull.push_back(rightHull[i]);
  while (i != upper.second)
  {
    i = (i + 1) % rightHull.size();
    mergedHull.push_back(rightHull[i]);
  }

  return mergedHull;
}
vector<Point> convexHull(vector<Point> &points)
{
  if (points.size() <= 3)
  {
    return bruteForceHull(points);
  }
  sort(points.begin(), points.end());
  int mid = points.size() / 2;
  vector<Point> leftPoints(points.begin(), points.begin() + mid);
  vector<Point> rightPoints(points.begin() + mid, points.end());
  vector<Point> leftHull = convexHull(leftPoints);
  vector<Point> rightHull = convexHull(rightPoints);

  return mergeHulls(leftHull, rightHull);
}

int main()
{
  vector<Point> points = {{0, 3}, {1, 1}, {2, 2}, {4, 4}, {0, 0}, {1, 2}, {3, 1}, {3, 3}};

  vector<Point> hull = convexHull(points);

  cout << "Convex Hull Points:\n";
  for (auto p : hull)
  {
    cout << "(" << p.x << ", " << p.y << ")\n";
  }

  return 0;
}
