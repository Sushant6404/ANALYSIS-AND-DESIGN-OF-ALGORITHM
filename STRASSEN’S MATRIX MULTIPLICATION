#include <iostream>
#include <vector>
using namespace std;

vector<vector<int>> add(const vector<vector<int>> &A, const vector<vector<int>> &B)
{
  int n = A.size();
  vector<vector<int>> C(n, vector<int>(n));
  for (int i = 0; i < n; i++)
    for (int j = 0; j < n; j++)
      C[i][j] = A[i][j] + B[i][j];
  return C;
}

vector<vector<int>> subtract(const vector<vector<int>> &A, const vector<vector<int>> &B)
{
  int n = A.size();
  vector<vector<int>> C(n, vector<int>(n));
  for (int i = 0; i < n; i++)
    for (int j = 0; j < n; j++)
      C[i][j] = A[i][j] - B[i][j];
  return C;
}

void split(const vector<vector<int>> &A, vector<vector<int>> &A11, vector<vector<int>> &A12,
           vector<vector<int>> &A21, vector<vector<int>> &A22, int size)
{
  for (int i = 0; i < size; i++)
  {
    for (int j = 0; j < size; j++)
    {
      A11[i][j] = A[i][j];
      A12[i][j] = A[i][j + size];
      A21[i][j] = A[i + size][j];
      A22[i][j] = A[i + size][j + size];
    }
  }
}

vector<vector<int>> join(const vector<vector<int>> &C11, const vector<vector<int>> &C12,
                         const vector<vector<int>> &C21, const vector<vector<int>> &C22, int size)
{
  int n = 2 * size;
  vector<vector<int>> C(n, vector<int>(n));
  for (int i = 0; i < size; i++)
  {
    for (int j = 0; j < size; j++)
    {
      C[i][j] = C11[i][j];
      C[i][j + size] = C12[i][j];
      C[i + size][j] = C21[i][j];
      C[i + size][j + size] = C22[i][j];
    }
  }
  return C;
}

vector<vector<int>> strassen(const vector<vector<int>> &A, const vector<vector<int>> &B, int size)
{
  // Base case
  if (size == 1)
  {
    vector<vector<int>> C(1, vector<int>(1));
    C[0][0] = A[0][0] * B[0][0];
    return C;
  }

  int newSize = size / 2;
  vector<vector<int>> A11(newSize, vector<int>(newSize)), A12(newSize, vector<int>(newSize)),
      A21(newSize, vector<int>(newSize)), A22(newSize, vector<int>(newSize));
  vector<vector<int>> B11(newSize, vector<int>(newSize)), B12(newSize, vector<int>(newSize)),
      B21(newSize, vector<int>(newSize)), B22(newSize, vector<int>(newSize));

  split(A, A11, A12, A21, A22, newSize);
  split(B, B11, B12, B21, B22, newSize);

  auto P1 = strassen(A11, subtract(B12, B22), newSize);
  auto P2 = strassen(add(A11, A12), B22, newSize);
  auto P3 = strassen(add(A21, A22), B11, newSize);
  auto P4 = strassen(A22, subtract(B21, B11), newSize);
  auto P5 = strassen(add(A11, A22), add(B11, B22), newSize);
  auto P6 = strassen(subtract(A12, A22), add(B21, B22), newSize);
  auto P7 = strassen(subtract(A11, A21), add(B11, B12), newSize);

  auto C11 = add(subtract(add(P5, P4), P2), P6);
  auto C12 = add(P1, P2);
  auto C21 = add(P3, P4);
  auto C22 = subtract(subtract(add(P1, P5), P3), P7);
  return join(C11, C12, C21, C22, newSize);
}

int main()
{
  vector<vector<int>> A = {{1, 2}, {3, 4}};
  vector<vector<int>> B = {{5, 6}, {7, 8}};

  auto C = strassen(A, B, 2);

  cout << "Result matrix:" << endl;
  for (const auto &row : C)
  {
    for (int val : row)
    {
      cout << val << " ";
    }
    cout << endl;
  }
  return 0;
}
